import go strings from "strings";
import go sync from "sync";

class TodoStore {
  private mutex: sync.RWMutex;
  private nextID: int;
  private todos: { id: int, title: string, completed: boolean }[];

  constructor() {
    this.mutex = sync.RWMutex{};
    this.nextID = 3;
    this.todos = [
      { id: 1, title: "Read the Kinmokusei source", completed: true },
      { id: 2, title: "Try both Go backends", completed: false },
    ];
  }

  public function list(): { id: int, title: string, completed: boolean }[] {
    this.mutex.RLock();
    defer this.mutex.RUnlock();
    let snapshot: { id: int, title: string, completed: boolean }[] = [];
    return append(snapshot, this.todos...);
  }

  public function create(title: string): { id: int, title: string, completed: boolean } {
    this.mutex.Lock();
    defer this.mutex.Unlock();
    const todo = { id: this.nextID, title: title, completed: false };
    this.nextID++;
    this.todos = append(this.todos, todo);
    return todo;
  }

  public function toggle(id: int): { value: { id: int, title: string, completed: boolean }, found: boolean } {
    this.mutex.Lock();
    defer this.mutex.Unlock();
    for (let index = 0; index < len(this.todos); index++) {
      if (this.todos[index].id == id) {
        let updated = this.todos[index];
        updated.completed = !updated.completed;
        this.todos[index] = updated;
        return { value: updated, found: true };
      }
    }
    return {
      value: { id: 0, title: "", completed: false },
      found: false,
    };
  }

  public function remove(id: int): boolean {
    this.mutex.Lock();
    defer this.mutex.Unlock();
    let remaining: { id: int, title: string, completed: boolean }[] = [];
    let removed = false;
    for (const todo of this.todos) {
      if (todo.id == id) {
        removed = true;
      } else {
        remaining = append(remaining, todo);
      }
    }
    this.todos = remaining;
    return removed;
  }
}

function normalizedTitle(title: string): string {
  return strings.TrimSpace(title);
}
