import go { Println } from "fmt"

constraint Sequence<E> = ~E[] | ~[2]E | ~*[3]E
constraint Text = ~string | ~byte[]

function head<E, S extends Sequence<E>>(values: S): E {
  return values[0]
}

function suffix<T extends Text>(value: T): T {
  return value[1:]
}

function main(): void {
  const pair: [2]int = [7, 8]
  const values: byte[] = [65, 66, 67]
  const rest: byte[] = suffix(values)
  rest[0] = 90
  Println(head<int, [2]int>(pair), suffix("ABC"), string(values))
}
