import go fmt from "fmt";
import go slices from "slices";

constraint Slice<E> = ~E[];
function size<S extends Slice<E>, E>(values: S): int {
  let count = 0;
  for (const _ of values) { count++; }
  return count;
}

interface Reader<T> { function read(): T; }
interface Writer<T> { function write(value: T): void; }
interface Storage<T> extends Reader<T>, Writer<T> {}

class Store<T> implements Storage<T> {
  private values: T[] = [];

  public function write(value: T): void {
    this.values = append(this.values, value);
  }

  public function read(): T { return this.values[0]; }
  public function echo<U>(value: U): U { return value; }
}

function main(): void {
  let total = 0;
  for (const value of 3) { total += value; }
  const store = new Store<int>();
  const storage: Storage<int> = store;
  for (const value of slices.Values([total])) { storage.write(value); }
  const z = 2.5 + 4i;
  fmt.Println(storage.read(), size([1, 2, 3]), store.echo(0b10), real(z), imag(z));
}
