import go fmt from "fmt";

enum Status { Pending, Running = 4, Complete }

function total(values: int[]): int {
  let result = 0;
  for (const value of values) {
    result += value;
  }
  return result;
}

function classify(status: Status): string {
  switch (status) {
    case Status.Pending { return "pending"; }
    case Status.Running { return "running"; }
    case Status.Complete { return "complete"; }
  }
  return "unknown";
}

function main(): void {
  fmt.Println(total([2, 4, 6]), classify(Status.Complete));
}
