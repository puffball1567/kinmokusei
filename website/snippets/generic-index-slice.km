import go { Println } from "fmt"

constraint Slice<E> = ~E[]

function first<E, S extends Slice<E>>(values: S): E {
  return values[0]
}

function window<E, S extends Slice<E>>(values: S): S {
  return values[1:3:3]
}

type Numbers = distinct int[]

function main(): void {
  const values = Numbers([1, 2, 3, 4])
  const view: Numbers = window(values)
  view[0] = 9
  Println(first(values), values[1], len(view), cap(view))
}
