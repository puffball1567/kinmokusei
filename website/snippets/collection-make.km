import go { Println } from "fmt"

constraint Slice<E> = ~E[]
constraint Number = ~int | ~int32 | ~int64
type Numbers = distinct int[]

function allocate<E extends Number, T extends Slice<E>>(length: int, capacity: int): T {
  return make[T](length, capacity)
}

function main(): void {
  const numbers = allocate<int, Numbers>(2, 4)
  numbers[0] = 7
  const lookup = make[Map<string, int>]()
  lookup["answer"] = numbers[0]
  const channel = make[GoChannel<int>](1)
  channel <- lookup["answer"]
  Println(len(numbers), cap(numbers), <-channel)
  closeGoChannel(channel)
}
