import go errors from "errors";
import go fmt from "fmt";

function square(value: int): int {
  return value * value;
}

function load(ready: boolean): Result<int> {
  if (!ready) { return fail(errors.New("not ready")); }
  return ok(7);
}

function joinedResult(ready: boolean): Result<int> {
  const task: Task<Result<int>> = go load(ready);
  const value = await task?;
  return ok(value * 2);
}

function main(): void {
  const first = go square(4);
  const second = go square(5);
  const firstValue = await first;
  const secondValue = await second;
  const [checked, checkedErr] = joinedResult(true);
  const [failed, failedErr] = joinedResult(false);
  fmt.Println(
    firstValue, secondValue,
    checked, checkedErr === nil,
    failed, failedErr !== nil,
  );
}
