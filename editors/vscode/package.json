{
  "name": "kinmokusei",
  "displayName": "Kinmokusei",
  "description": "Language support for Kinmokusei",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "publisher": "kinmokusei",
  "private": true,
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/puffball1567/kinmokusei.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/puffball1567/kinmokusei#readme",
  "bugs": {
    "url": "https://github.com/puffball1567/kinmokusei/issues"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "Kinmokusei",
    "kinmokusei",
    "yn",
    "language server"
  ],
  "activationEvents": [
    "onLanguage:kinmokusei",
    "onCommand:kinmokusei.restartLanguageServer"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kinmokusei",
        "aliases": [
          "Kinmokusei",
          "kinmokusei"
        ],
        "extensions": [
          ".km"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kinmokusei",
        "scopeName": "source.kinmokusei",
        "path": "./syntaxes/kinmokusei.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kinmokusei.restartLanguageServer",
        "title": "Kinmokusei: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Kinmokusei",
      "properties": {
        "kinmokusei.server.path": {
          "type": "string",
          "default": "keika",
          "scope": "machine-overridable",
          "description": "Path to the keika executable. The extension always invokes it as 'keika lsp --stdio'."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/run.js",
    "package:vsix": "node scripts/package-vsix.js"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2"
  }
}
